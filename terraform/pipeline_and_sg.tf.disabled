# 1. Default VPC Lookup & Security Group (Satisfies JD "security groups")
data "aws_vpc" "default" {
  default = true
}

resource "aws_security_group" "lambda_validator_sg" {
  name        = "blast-radius-lambda-sg"
  description = "Least-privilege egress for Blast-Radius validator and controller"
  vpc_id      = data.aws_vpc.default.id

  egress {
    description = "Allow HTTPS to AWS APIs and S3 Gateway"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Project = "blast-radius" }
}

# 2. IAM Role for AWS CodePipeline
resource "aws_iam_role" "codepipeline_role" {
  name = "blast-radius-codepipeline-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "codepipeline.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "codepipeline_policy" {
  name = "blast-radius-codepipeline-policy"
  role = aws_iam_role.codepipeline_role.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:GetBucketVersioning", "s3:PutObjectAcl", "s3:PutObject"]
        Resource = ["${aws_s3_bucket.config_store.arn}", "${aws_s3_bucket.config_store.arn}/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["codebuild:BatchGetBuilds", "codebuild:StartBuild"]
        Resource = "*"
      },
      {
        Effect   = "Allow"
        Action   = ["codedeploy:CreateDeployment", "codedeploy:GetApplication", "codedeploy:GetApplicationRevision", "codedeploy:GetDeployment", "codedeploy:GetDeploymentConfig", "codedeploy:RegisterApplicationRevision"]
        Resource = "*"
      }
    ]
  })
}

# 3. AWS CodePipeline (Source -> Build -> SRE Approval -> CodeDeploy Canary)
resource "aws_codepipeline" "blast_radius_pipeline" {
  name     = "blast-radius-sre-pipeline"
  role_arn = aws_iam_role.codepipeline_role.arn

  artifact_store {
    location = aws_s3_bucket.config_store.bucket
    type     = "S3"
  }

  stage {
    name = "Source"
    action {
      name             = "S3Source"
      category         = "Source"
      owner            = "AWS"
      provider         = "S3"
      version          = "1"
      output_artifacts = ["source_output"]
      configuration = {
        S3Bucket             = aws_s3_bucket.config_store.bucket
        S3ObjectKey          = "source/repo.zip"
        PollForSourceChanges = "false"
      }
    }
  }

  stage {
    name = "Build"
    action {
      name             = "BashValidateAndBuild"
      category         = "Build"
      owner            = "AWS"
      provider         = "CodeBuild"
      input_artifacts  = ["source_output"]
      output_artifacts = ["build_output"]
      version          = "1"
      configuration = {
        ProjectName = aws_codebuild_project.blast_radius_build.name
      }
    }
  }

  stage {
    name = "SRE_Manual_Approval"
    action {
      name     = "VerifyErrorBudget"
      category = "Approval"
      owner    = "AWS"
      provider = "Manual"
      version  = "1"
    }
  }

  stage {
    name = "Deploy"
    action {
      name            = "CodeDeployCanary10Pct"
      category        = "Deploy"
      owner           = "AWS"
      provider        = "CodeDeploy"
      input_artifacts = ["build_output"]
      version         = "1"
      configuration = {
        ApplicationName     = aws_codedeploy_app.validator_app.name
        DeploymentGroupName = aws_codedeploy_deployment_group.validator_canary.deployment_group_name
      }
    }
  }

  tags = { Project = "blast-radius" }
}
